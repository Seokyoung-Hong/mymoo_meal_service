DEBUG=False
ENV=production

SERVICE_ACCOUNT_SUB=replace-with-service-account-sub
SERVICE_ACCOUNT_TOKEN=replace-with-service-account-token-if-needed
SERVICE_ACCOUNT_TOKEN_TYPE=Bearer

# Runtime config
MEAL_TYPES_FILE_NAME=meal_types.json
USER_SERVICE_URL=http://user-service:8000/
CORS_ALLOW_ORIGINS=http://localhost:5601,http://127.0.0.1:5601,https://mymoo.quanect.kr
TIMEZONE=Asia/Seoul

# DATABASE_URL takes precedence over POSTGRES_* when set.
DATABASE_URL=postgresql+asyncpg://postgres:change-this-db-password@mymoo-meal-service-db:5432/meal_service

KC_SERVER_URL=https://auth.quanect.kr/
KC_CLIENT_ID=mymoo-meal-service
KC_REALM=Mymoo

# Primary auth validates Authorization: Bearer JWTs through OIDC discovery/JWKS.
# Keep this false by default. Never enable in production.
AUTH_DEV_HEADER_FALLBACK_ENABLED=false
KEYCLOAK_DISCOVERY_URL=https://auth.quanect.kr/realms/Mymoo/.well-known/openid-configuration
JWT_ISSUER=https://auth.quanect.kr/realms/Mymoo
JWT_AUDIENCE=mymoo-meal-service
JWT_ALLOWED_ALGORITHMS=RS256
JWT_CLIENT_ID=mymoo-meal-service

# PostgreSQL connection pieces used when DATABASE_URL is unset.
POSTGRES_DB=meal_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_HOST=mymoo-meal-service-db
POSTGRES_PORT=5432

# Image upload settings.
# IMAGE_PUBLIC_BASE_URL is REQUIRED behind a reverse proxy — without it, image
# URLs are built from request.base_url, which points at the internal host.
IMAGE_PUBLIC_BASE_URL=https://mymoo.quanect.kr/meal
# Storage root (originals/ and public/ are created under it). Keep it on the
# docker volume path in containers.
#IMAGE_DIR=/app/data/images
#IMAGE_MAX_UPLOAD_BYTES=20971520
#IMAGE_MAX_PIXELS=40000000
# Derived image policy. Two variants are generated per upload:
# full (keeps aspect ratio, long side <= IMAGE_FULL_SIZE) and
# thumbnail (center-cropped to IMAGE_TARGET_RATIO, long side <= IMAGE_THUMBNAIL_SIZE).
#IMAGE_TARGET_RATIO=1:1
#IMAGE_FULL_SIZE=1600
#IMAGE_THUMBNAIL_SIZE=400
#IMAGE_WEBP_QUALITY=80
# Orphan cleanup job (images never referenced by any resource).
#IMAGE_CLEANUP_ENABLED=true
#IMAGE_CLEANUP_INTERVAL_HOURS=24
#IMAGE_ORPHAN_GRACE_HOURS=24

# BLE 중계(POST /relay) 식권 토큰 서명 키. 32바이트 hex 권장:
#   python -c "import secrets; print(secrets.token_hex(32))"
# 비우면 프로세스마다 임시 키를 만들어 재시작 시 발급된 토큰이 무효가 된다.
RELAY_TOKEN_SECRET=
# 같은 (식당, 근로자) 결제 결정을 재사용하는 창(초). 재스캔 이중 결제를 막는다.
#RELAY_DECISION_TTL_SECONDS=90
